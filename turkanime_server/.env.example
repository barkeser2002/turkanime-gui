# Arşiv yayıncısı (Faz 12) — ÖRNEK. Kopyala: cp .env.example .env
#
# `.env` .gitignore'da; buraya GERÇEK bir token yazma. Yayıncı token'ı yalnızca
# ortamdan okur, `.git/config`'e yazmaz ve komut satırına koymaz — log'lara da
# maskelenmiş hâliyle düşer.

# ── Hedef depo ───────────────────────────────────────────────────────────────
# Adrese kimlik GÖMME (https://user:token@... yazma): git bunu .git/config'e
# yazar ve arşiv dizini elden ele geçtiğinde token da onunla gider.
TURKANIME_ARSIV_UZAK=https://gitlab.com/kullanici/animedepo-arsiv.git
TURKANIME_ARSIV_DAL=master

# ── Kimlik: HTTPS token ──────────────────────────────────────────────────────
# GitLab deploy token / project access token ya da GitHub PAT.
# Yalnızca `write_repository` (GitLab) veya `contents:write` (GitHub) yetkisi
# verin: yayıncının başka hiçbir şeye ihtiyacı yok.
TURKANIME_ARSIV_TOKEN=
# GitLab deploy token'da token'ın kullanıcı adı; GitHub PAT'te herhangi bir
# değer olabilir. Boş bırakılırsa "oauth2".
TURKANIME_ARSIV_KULLANICI=oauth2

# ── Kimlik: SSH (token yerine tercih edilir) ─────────────────────────────────
# Anahtar dosyası konteynere salt-okunur bağlanmalı (docker-compose'a bakın).
# Doluysa TURKANIME_ARSIV_UZAK de ssh biçiminde olmalı:
#   git@gitlab.com:kullanici/animedepo-arsiv.git
#TURKANIME_ARSIV_SSH_ANAHTAR=/sirlar/arsiv_ed25519

# ── Commit kimliği ───────────────────────────────────────────────────────────
TURKANIME_ARSIV_AD=turkanime-arsiv
TURKANIME_ARSIV_EPOSTA=turkanime-arsiv@users.noreply.localhost

# ── Depo şişmesi ─────────────────────────────────────────────────────────────
# Bu commit sayısı aşılınca geçmiş tek bir kök commit'e indirilir ve zorla
# itilir (arşiv bir ayna, kimse eski sürümünü klonlamıyor). 0 = kapalı.
TURKANIME_ARSIV_AZAMI_GECMIS=200
# Her N commit'te bir tam `git gc`; aradaki turlarda yalnızca --auto.
TURKANIME_ARSIV_BAKIM_ARALIGI=25

# ── İstemci tarafı (turkanime_api/sources/animedepo.py) ──────────────────────
# Yayınlanan arşivin HAM (raw) kök adresi. Ayarlanmazsa istemci varsayılan
# KebabLord arşivini okumaya devam eder — davranış değişmez.
#   GitLab: https://gitlab.com/<kullanici>/<depo>/-/raw/master
#   GitHub: https://raw.githubusercontent.com/<kullanici>/<depo>/master
#TURKANIME_ARSIV_URL=https://gitlab.com/kullanici/animedepo-arsiv/-/raw/master
